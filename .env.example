# Database
DATABASE_URL="postgresql://user:password@localhost:5432/invoice_platform?schema=public"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Anthropic (Claude) — used for document extraction + the agent
ANTHROPIC_API_KEY=sk-ant-xxx
# Claude model id. Optional: defaults to claude-sonnet-4-6. When this model is
# retired, set the new id here (and in Vercel) and redeploy — no code change.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Skip env validation during build (optional)
# SKIP_ENV_VALIDATION=true

# Background contact imports (large PDFs) — the DB is the queue, no external
# service. Jobs start instantly on upload; a Vercel Cron (vercel.json, every
# minute) is the safety net that resumes anything unfinished. Set CRON_SECRET
# in Vercel so only Vercel can hit /api/cron/process-imports.
# CRON_SECRET=
